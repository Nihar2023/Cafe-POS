{
  "name": "cafe-pos",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace server && npm run build --workspace client",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:upgrade": "npm run db:upgrade --workspace server",
    "db:reset-accounts": "npm run db:reset-accounts --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "test": "npm run test --workspace server"
  },
  "workspaces": ["client", "server"],
  "devDependencies": { "concurrently": "^9.1.2" }
}

