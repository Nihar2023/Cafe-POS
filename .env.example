DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cafe_pos
JWT_SECRET=replace-with-a-long-random-value
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp order message via Twilio. The content SID must be an approved WhatsApp template.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_WHATSAPP_CONTENT_SID=HX_REPLACE_WITH_APPROVED_TEMPLATE_SID
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Real OTP verification through Twilio Verify. Create a Verify service, then add its SID here.
TWILIO_VERIFY_SERVICE_SID=

# Customer email receipts through Resend. The sender must be a verified Resend domain/address.
RESEND_API_KEY=
RECEIPT_EMAIL_FROM="Cafe POS <receipts@example.com>"

